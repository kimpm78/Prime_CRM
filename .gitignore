# OS files
.DS_Store
Thumbs.db

# IDE and editor settings
.idea/
.fleet/
.vscode/
.zed/
*.swp
*.swo
*~

# Local environment files (keep templates)
/.env
/.env.*
!/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
!/frontend/.env.production.example

# PHP / Laravel dependencies and generated files
/backend/vendor/
/backend/node_modules/
/backend/auth.json
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/bootstrap/cache/*.php
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/pail/
/backend/database/*.sqlite
/backend/database/*.sqlite-*
/backend/coverage/

# Vue / Vite dependencies and build output
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/coverage/

# Package manager and application logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Docker overrides
/docker-compose.override.yml
/compose.override.yml
